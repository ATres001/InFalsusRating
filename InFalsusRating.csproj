<Project Sdk="Microsoft.NET.Sdk">

  <!-- In Falsus Rating — pre1.0
       构建：dotnet build -c Release
       游戏不在默认位置就传：dotnet build -c Release -p:GameDir="D:\...\In Falsus" -->

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>InFalsusRating</AssemblyName>
    <RootNamespace>InFalsusRating</RootNamespace>
    <Version>0.9.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\In Falsus</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem">
      <HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Addressables">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.Addressables.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.ResourceManager">
      <HintPath>$(GameDir)\BepInEx\interop\Unity.ResourceManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Game.Common">
      <HintPath>$(GameDir)\BepInEx\interop\Game.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Game.Data">
      <HintPath>$(GameDir)\BepInEx\interop\Game.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- GameProbe / Win32Overlay 是 partial 类型：按下面的顺序编译。 -->
  <ItemGroup>
    <Compile Remove="GameProbe*.cs" />
    <Compile Remove="Win32Overlay*.cs" />
    <Compile Include="GameProbe.cs" />
    <Compile Include="GameProbe.StoryBg.cs" />
    <Compile Include="GameProbe.Chart.cs" />
    <Compile Include="GameProbe.Mv.cs" />
    <Compile Include="GameProbe.Export.cs" />
    <Compile Include="Win32Overlay.cs" />
    <Compile Include="Win32Overlay.PlayerPanel.cs" />
    <Compile Include="Win32Overlay.Settlement.cs" />
    <Compile Include="Win32Overlay.HpBar.cs" />
    <Compile Include="GameProbe.Music.cs" />
    <Compile Include="Win32Overlay.Toast.cs" />
    <Compile Include="GameProbe.Util.cs" />
  </ItemGroup>

</Project>
